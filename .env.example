# OpenRouter API Key for NormanJr.
OPENROUTER_API_KEY=""

# OpenRouter Model to use for UX audit reasoning and heuristic evaluation
# Popular choices:
#   google/gemini-2.5-flash (fast, low cost, multimodal - default)
#   google/gemini-2.0-flash-exp:free (free tier)
#   anthropic/claude-3.5-sonnet
#   openai/gpt-4o-mini
#   meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER="https://github.com/normanjr/normanjr"
OPENROUTER_TITLE="NormanJr UX Auditor"

# Optional logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"
